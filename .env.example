# Gauntlet uses per-app env files:
#   apps/backend/.env         (copy from apps/backend/.env.example)
#   apps/frontend/.env.local  (copy from apps/frontend/.env.local.example)
# Quick offline demo (no Brev needed):
#   USE_FALLBACK_ATTACKS=1 USE_RULE_JUDGE=1 make dev
BREV_BASE_URL=https://your-brev-endpoint.example.com/v1
BREV_API_KEY=replace-me
BREV_MODEL=replace-me
