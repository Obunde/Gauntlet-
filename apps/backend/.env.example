# Copy to apps/backend/.env and fill in. Never commit the real .env.
BREV_BASE_URL=https://your-brev-endpoint.example.com/v1
BREV_API_KEY=replace-me
BREV_MODEL=replace-me
TARGET_URL=http://localhost:8001
HARDENED=0
CORS_ORIGINS=http://localhost:3000
# Set to 1 to run fully offline (no Brev calls)
USE_RULE_JUDGE=0
USE_FALLBACK_ATTACKS=0
